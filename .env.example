# Copiar este archivo a .env.local y completar con los valores de tu proyecto
# Supabase > Project Settings > API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Registro público de nuevos usuarios. Por defecto desactivado (solo login).
# Poner en "true" únicamente si querés permitir "Crear cuenta" desde la app.
VITE_ALLOW_SIGNUP=false
